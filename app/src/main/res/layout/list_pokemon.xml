<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Este es el linearlayout principal que contiene todos los datos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/tvNombre"
            android:textAlignment="center"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre" />

        <!-- Este es el linearlayout que contiene cada titulo de atributo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHp"
                android:textAlignment="center"
                android:fontFamily="@font/inter_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HP" />

            <TextView
                android:id="@+id/tvAtaque"
                android:textAlignment="center"
                android:fontFamily="@font/inter_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ataque" />

            <TextView
                android:id="@+id/tvDefensa"
                android:textAlignment="center"
                android:fontFamily="@font/inter_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Defensa" />

            <TextView
                android:id="@+id/tvVelocidad"
                android:textAlignment="center"
                android:fontFamily="@font/inter_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Velocidad" />
        </LinearLayout>

        <!-- Este es el linearlayout que contiene los datos de cada atributo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/valorHp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hp"
                android:text="NN"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/valorAtaque"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ataque"
                android:text="NN"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/valorDefensa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/defensa"
                android:text="NN"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/valorVelocidad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/velocidad"
                android:text="NN"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>